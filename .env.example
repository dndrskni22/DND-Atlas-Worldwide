# CargoTrace – Global Shipment Visibility & Tracking Platform
# Web Programming 2 Final Project (UAS) Environment Configuration Template
#
# Note: CargoTrace uses keyless public open-data APIs (OpenStreetMap, Nominatim, Open-Meteo)
# and in-app Group Configuration (Preferences -> Setting), so no secret API keys are required.
#
# For Laravel 12 / local deployment reference:
# APP_NAME="CargoTrace"
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:3000
# CARGOTRACE_GROUP="Group A"
# CARGOTRACE_PRIMARY_ROUTE="Southeast Asia -> Europe"
# CARGOTRACE_DELAY_THRESHOLD_HOURS=12
# CARGOTRACE_MAIN_EXCEPTION_FOCUS="CUSTOMS_HOLD"
# CARGOTRACE_GROUP_KPI="On-Time Delivery Rate"
# CARGOTRACE_MULTIMODAL_MODEL="Option A"
# VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
