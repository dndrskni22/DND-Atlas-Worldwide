# =============================================================================
# DND Atlas Worldwide (CargoTrace) – Laravel 12 + MySQL 8.0 Configuration
# Web Programming 2 Final Project (UAS)
# =============================================================================

APP_NAME="DND Atlas Worldwide"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MySQL 8.0+ Relational Database Configuration (Brief Slide 11 & Slide 14)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace_db
DB_USERNAME=cargotrace_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Laravel Sanctum & Session Security (Brief Slide 12 & Slide 16)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# -----------------------------------------------------------------------------
# Unique Group Scenario Parameters (Brief Slide 20 & Slide 23 - Group A)
# -----------------------------------------------------------------------------
CARGOTRACE_GROUP="Group A"
CARGOTRACE_PRIMARY_ROUTE="Southeast Asia -> Europe"
CARGOTRACE_DELAY_THRESHOLD_HOURS=12
CARGOTRACE_MAIN_EXCEPTION_FOCUS="CUSTOMS_HOLD"
CARGOTRACE_GROUP_KPI="On-Time Delivery Rate"
CARGOTRACE_MULTIMODAL_MODEL="Option A"

# -----------------------------------------------------------------------------
# External API Endpoints (Brief Slide 9 & Slide 15 - HTTP Client)
# -----------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_CLIENT_TIMEOUT_SECONDS=4

VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
